#!/bin/sh
# ============================================================================
# pre-push hook — allinea il cluster DMI con il working tree: src/, cluster/,
# experiments/configs/, pyproject.toml, main.py.
#
# Sincronizza SEMPRE (non solo cio' che cambia nel push) con un solo
# trasferimento: se una copia fallisce (VPN giu', cluster irraggiungibile) il
# push prosegue, e quello successivo la ripara da solo. Prima copiava solo le
# cartelle toccate dal push e una copia fallita non veniva piu' ritentata:
# cluster/presets.yaml era rimasto fuori per settimane.
#
# Il working tree (non il commit) e' la fonte, come con scp. Non cancella nulla
# sul cluster (un file tolto dal repo resta li').
#
# Installazione (una tantum):
#   git config core.hooksPath .githooks
# ============================================================================

REPO_DIR="$(git rev-parse --show-toplevel)"
CLUSTER="bllgpp02h24c351g@gcluster.dmi.unict.it"
REMOTE_BASE="neuro_symbolic_t2g"
PATHS="src cluster experiments/configs pyproject.toml main.py"

# Il hook legge lo stdin del push solo per svuotarlo: non serve sapere cosa parte.
cat >/dev/null

cd "$REPO_DIR" || exit 0

EXISTING=""
for P in $PATHS; do
    [ -e "$P" ] && EXISTING="$EXISTING $P"
done

if ! ssh -o BatchMode=yes -o ConnectTimeout=12 "$CLUSTER" true 2>/dev/null; then
    echo "[pre-push] ⚠️  Cluster irraggiungibile (VPN?): NIENTE sincronizzato."
    echo "[pre-push]    Verra' ripreso dal prossimo push, o a mano:"
    echo "[pre-push]    git ls-files $PATHS | tar cf - -T - | ssh gcluster 'cd ~/$REMOTE_BASE && tar xf -'"
    exit 0  # non bloccare mai il push su GitHub
fi

echo "[pre-push] Allineo il cluster:${EXISTING}"
# Solo i file tracciati: niente __pycache__, .pyc o file locali non committati.
git ls-files -- $EXISTING | tar cf - -T - 2>/dev/null \
    | ssh -o BatchMode=yes "$CLUSTER" "mkdir -p ~/$REMOTE_BASE && cd ~/$REMOTE_BASE && tar xf -"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "[pre-push] ❌ Sincronizzazione fallita (codice $STATUS): ritentera' il prossimo push."
else
    echo "[pre-push] ✅ Cluster sync done"
fi

exit 0  # non bloccare mai il push su GitHub
